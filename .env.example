# =============================================================================
# Innoventix Platform v2 — Environment Variables Template
# Copy to .env.local for local development. Never commit real secrets to Git.
# =============================================================================

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=54322
DB_NAME=innoventix
DB_USER=postgres
DB_PASSWORD=postgres_dev_password
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:54322/innoventix
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT_MS=5000

# --- Custom JWT Authentication ---
JWT_SECRET=replace_with_min_32_char_random_secret_string
JWT_EXPIRES_IN=3600
REFRESH_TOKEN_SECRET=replace_with_min_32_char_random_refresh_secret_string
REFRESH_TOKEN_EXPIRES_IN=604800
COOKIE_NAME=innoventix_session
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- Stripe Billing (Optional) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# --- AI & Automation (Optional) ---
OPENAI_API_KEY=sk-placeholder
ANTHROPIC_API_KEY=sk-ant-placeholder
N8N_WEBHOOK_SECRET=placeholder_secret

# --- Email Notifications (Optional) ---
RESEND_API_KEY=re_placeholder
EMAIL_FROM="Innoventix <notifications@example.com>"
