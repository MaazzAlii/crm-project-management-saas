# ========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================

# PostgreSQL Connection (Contabo Server)
DB_HOST=postgres.innoventixhub.com
DB_PORT=5432
DB_NAME=innoventix_prod
DB_USER=innoventix_app
DB_PASSWORD=

# Connection Pool Settings
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT=5000
DB_IDLE_TIMEOUT=30000

# JWT Secrets (GENERATE NEW - DO NOT REUSE FROM DEV)
JWT_SECRET=
JWT_EXPIRES_IN=3600
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=604800

# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://project-manager.calara.agency
NEXT_PUBLIC_API_URL=https://project-manager.calara.agency/api

# Security
COOKIE_NAME=innoventix_session
COOKIE_DOMAIN=.calara.agency
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

# Stripe (Production Keys)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# n8n Automation
AUTOMATION_WEBHOOK_SECRET=
N8N_BASE_URL=

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=
DATADOG_API_KEY=

# Email (for notifications)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=

# Backups
BACKUP_SCHEDULE=0 2 * * * # Daily at 2 AM
S3_BACKUP_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
